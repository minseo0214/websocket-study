{
  "name": "websocket-study",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.14.1 <25",
    "npm": ">=11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace @websocket-study/server",
    "dev:client": "npm run dev --workspace @websocket-study/client",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces"
  }
}
